# URL pública del juego, usada al compartir
VITE_SITE_URL=https://chamusqueros.vercel.app
# Apaga la barra de resultados en vivo si vale exactamente "off" (en Vercel exige redesplegar). Sin valor, está encendida.
# La fuente de resultados en vivo (ESPN) es pública y no usa llave.
# Resultados en vivo: apagados por defecto (ESPN bloquea a Vercel). "on" los enciende.
ESPN_EN_VIVO=

# Retos en línea (specs/retos-en-linea). Solo del servidor: va en Vercel (Production y Preview) y en .env.local, nunca con prefijo VITE_.
# Llave de Ably (idApp.idLlave:secreto), limitada a los canales retos:* con publish y subscribe. Sin ella el modo en línea no está disponible y el resto del sitio funciona igual.
ABLY_API_KEY=
# Dominio con el que se arma el link para compartir una sala. Vacío = https://chamusqueros.vercel.app. Nunca sale del encabezado Host de la petición.
SITE_URL=
# Para probar en local sin llave de Ably, con el transporte de sondeo del navegador: descomentar.
# EN_LINEA_DEV=1
